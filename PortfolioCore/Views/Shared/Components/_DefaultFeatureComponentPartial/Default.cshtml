@model SocialMedia;

<section id="hero" class="hero section dark-background">

    <img src="~/images/t4.jpg" style="background-size: cover; background-position: center;background-attachment: fixed; background-repeat:no-repeat; " alt="">

    <div class="container" data-aos="zoom-out">
       
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <h2>Cansu Kocaoglu</h2>
                <p>I'm <span class="typed" data-typed-items=".Net Software Developer, Freelancer">Designer</span><span class="typed-cursor typed-cursor--blink" aria-hidden="true"></span></p>
                <div class="social-links">
                    <a href="@Model.Twitter"><i class="bi bi-twitter-x"></i></a>
                    <a href="@Model.Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="@Model.Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="@Model.Linkedin"><i class="bi bi-linkedin"></i></a>
                </div>
            </div>
        </div>
    </div>

</section>
@model About
<section id="about" class="about section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>About</h2>
    
        <div class="container" data-aos="fade-up" data-aos-delay="100">
      
            <div class="row gy-4 justify-content-center">
            <div class="col-lg-4">
                    <img src="@Model.ImageUrl" class="img-fluid" alt="">
            </div>
                <div class="col-lg-8 content p-5 mt-5">
                
                <p class="fst-italic py-3">

                </p>
                <div class="row">
                    <div class="col-lg-6">
                        <ul>
                            <li><i class="bi bi-chevron-right"></i> <strong>Birthday:</strong> <span>@Model.Birthday</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Phone:</strong> <span>@Model.Phone</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>City:</strong> <span>@Model.City</span></li>
                        </ul>
                    </div>
                    <div class="col-lg-6">
                        <ul>
                            <li><i class="bi bi-chevron-right"></i> <strong>Email:</strong> <span>@Model.Email</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Freelance:</strong> <span>@Model.Freelance</span></li>
                        </ul>
                    </div>
                </div>
                <p class="py-5">
                        @Model.Description
                </p>
            </div>
        </div>
            
    </div>

</section>
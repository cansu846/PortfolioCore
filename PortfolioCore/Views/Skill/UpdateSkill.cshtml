@model Skill
@{
    ViewData["Title"] = "UpdateSkill";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="container">
	<h4 class="page-title"></h4>
	<div class="row">
		<div class="col-md-12">
			<div class="card">
				<div class="card-header">
					<div class="card-title">Update Skill</div>
				</div>
				<div class="card-body">
					<form method="post" action="/Skill/UpdateSkill">
						<input asp-for="SkillId" hidden/>
						<div class="form-group">
							<label>Skill Name</label>
							<input type="text" class="form-control" asp-for="SkillName" />
						</div>
						<div class="form-group">
							<label>Skill Value</label>
							<input type="number" class="form-control" asp-for="SkillValue" />
						</div>

						<div class="card-action">
							<button class="btn btn-success">Update</button>
						</div>
					</form>
				</div>
			</div>

		</div>
	</div>
</div>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css">

